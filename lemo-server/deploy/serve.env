# ============================================================
# GalaxeaVLA A1Z 推理服务配置 —— 用户只需要改这一个文件
# 改完后重新 bash deploy/start_serve.sh 生效
# ============================================================

# 模型资源根目录，包含 g05/ 和 processor 目录
G05_WORKSPACE=$HOME/workspace/lemo-models

# 模型：g05/ 下的训练目录名和权重文件名（不带 .pt）
MODEL_RUN=h20_step35000_sz
MODEL_STEP=step_35000

# 服务监听端口(板端 machine.yaml 的 policy.server_url 要指向它)
SERVE_PORT=8765

# action chunk 步数(与板端 policy_client 配套,勿随意改)
ACTION_STEPS=32

# 目标机器人形态(server 按它路由观测处理器,必须与板端 embodiment 一致)
EMBODIMENT=galaxea_a1z

# 推理设备
DEVICE=cuda

# Python 解释器；留空使用程序目录 .venv/bin/python
EFMNODE_PYTHON=

# ============================================================
# 模型类型:g05(默认,GalaxeaVLA 原生)| lerobot(DP/ACT/pi0 等)
# ============================================================
MODEL_TYPE=g05

# ── MODEL_TYPE=lerobot 时生效 ──
# lerobot ckpt 目录(含 config.json + model.safetensors)
LEROBOT_POLICY_PATH=
# 键名映射(默认即可,训练改特征名才动)
LEROBOT_MAPPING=
# 数据集 stats.json(ckpt 目录无 policy_preprocessor.json 时必填)
LEROBOT_STATS_PATH=
# Python 解释器；留空使用程序目录 .venv-lerobot/bin/python
LEROBOT_PYTHON=
# obs 未带 task 时的兜底任务文本(SmolVLA 等 VLA 类必填,DP 类可空)
LEROBOT_DEFAULT_TASK=
