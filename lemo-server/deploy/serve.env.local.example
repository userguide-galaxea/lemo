# 本机覆盖配置，不入库。安装环境后按所选模型手动填写；server_setup.sh 不修改本文件。
# G0.5 直接指定文件路径，无需旧 GalaxeaVLA 目录布局：
# MODEL_TYPE=g05
# G05_CHECKPOINT=/path/to/model.pt
# G05_TOKENIZER=/path/to/action_tokenizer.pt
# G05_PROCESSOR=/path/to/processor
# EFMNODE_PYTHON=/path/to/lemo-server/.venv/bin/python
# LeRobot：
# MODEL_TYPE=lerobot
# LEROBOT_POLICY_PATH=/path/to/pretrained_model
# LEROBOT_PYTHON=/path/to/lemo-server/.venv-lerobot/bin/python
# LEROBOT_DEFAULT_TASK="pick up the red cube"
# SERVE_PORT=8765
